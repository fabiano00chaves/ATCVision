# ==============================================================================
# ATC VISION — CONFIGURAÇÃO DE AMBIENTE (PRODUÇÃO & DESENVOLVIMENTO)
# ==============================================================================

# Porta exposta no Host (LXC Proxmox -> Nginx Proxy Manager)
HOST_PORT=8085

# Banco de Dados PostgreSQL 16
POSTGRES_DB=atc_vision
POSTGRES_USER=atc_user
POSTGRES_PASSWORD=atc_vision_secure_password_replace_in_production_2026

# Chave Criptográfica JWT (Gerar com: openssl rand -hex 32)
JWT_SECRET_KEY=94c1a84f3e6a2b84784914c62fa19e34e9e735d1f044bb7ad3bfae6efc792134
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Credenciais do Administrador Inicial (Seed na primeira execução)
ADMIN_INITIAL_EMAIL=admin@vision.fk.adm.br
ADMIN_INITIAL_PASSWORD=TrocarSenhaForte@Vision2026

# Domínios e CORS Autorizados (JSON Array)
CORS_ORIGINS=["https://vision.fk.adm.br", "http://localhost:8085", "http://127.0.0.1:8085"]

# Segurança de Cookies
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Armazenamento e Limites
MAX_UPLOAD_SIZE_MB=100
STORAGE_DIR=/app/storage
WATCH_FOLDER_PATH=/app/storage/watch
WATCH_FOLDER_INTERVAL_SECONDS=60
OCR_FALLBACK_ENABLED=true

# ==============================================================================
# INTEGRAÇÃO & SINCRONIZAÇÃO COM O GITHUB (USO LOCAL SEGURO)
# ==============================================================================
# SEGURANÇA CRÍTICA:
# 1. NUNCA remova o arquivo .env do seu .gitignore!
# 2. As variáveis abaixo são lidas exclusivamente pelos scripts seguros de envio
#    (push_to_github.ps1 e push_to_github.sh) e NUNCA são gravadas no .git/config
#    nem expostas no histórico de commits.
#
# URL HTTPS do repositório remoto (sem token embutido!)
# Exemplo: https://github.com/seu-usuario/ATC_Vision.git
GITHUB_REPO_URL=https://github.com/SEU_USUARIO/ATC_Vision.git

# Seu usuário ou organização no GitHub
GITHUB_USERNAME=SEU_USUARIO

# Personal Access Token (PAT) do GitHub com permissão de escrita ('repo' ou 'contents:write')
# Crie em: GitHub -> Settings -> Developer Settings -> Personal access tokens
GITHUB_TOKEN=ghp_SEU_TOKEN_PESSOAL_AQUI

# Nome da branch principal de envio (padrão: main)
GITHUB_BRANCH=main
